# ---------------------------------------------------------------------------
# Flight Disruption Monitoring System — root .gitignore
# Covers both backend (NestJS) and frontend (Vite + React).
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment files (NEVER commit; .env.example is the committed contract)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# Caches
.cache/
.parcel-cache/
.vite/
.eslintcache

# Editor / IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
